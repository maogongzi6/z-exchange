<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.exchange</groupId>
        <artifactId>z-exchange-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>stress-test</artifactId>

    <properties>
        <gatling.version>3.15.1</gatling.version>
        <gatling-maven-plugin.version>4.21.7</gatling-maven-plugin.version>
        <!-- This non-Spring module must use Gatling's Netty line. The Spring Boot 2.7
             parent otherwise manages Netty to 4.1.x, while Gatling 3.15 is compiled
             against Netty 4.2 APIs such as io.netty.channel.IoHandle. -->
        <netty.version>4.2.14.Final</netty.version>
        <netty-tcnative.version>2.0.77.Final</netty-tcnative.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gatling</groupId>
            <artifactId>gatling-grpc-java</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gatling</groupId>
            <artifactId>gatling-http-java</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.exchange</groupId>
            <artifactId>ledger-proto</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- The generated messages/descriptors are sufficient here. Avoid
                     mixing ledger-proto's Spring gRPC 1.42 runtime with Gatling's
                     current gRPC client runtime. -->
                <exclusion>
                    <groupId>net.devh</groupId>
                    <artifactId>grpc-server-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
                <configuration>
                    <simulationClass>com.exchange.stress.ledger.LedgerPostServiceSmokeSimulation</simulationClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
