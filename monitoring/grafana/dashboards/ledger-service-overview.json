    { "asDropdown": false, "icon": "external link", "includeVars": true, "keepTime": true, "tags": [], "targetBlank": false, "title": "Data access & resilience", "tooltip": "Open the shared database, Redis, cache, and idempotency dashboard", "type": "link", "url": "/d/service-data-access-overview/service-data-access-and-resilience" },
    { "asDropdown": false, "icon": "external link", "includeVars": true, "keepTime": true, "tags": [], "targetBlank": false, "title": "Runtime details", "tooltip": "Open the shared JVM and process dashboard", "type": "link", "url": "/d/service-runtime-overview/service-runtime-overview" },
    { "asDropdown": false, "icon": "external link", "includeVars": true, "keepTime": true, "tags": [], "targetBlank": false, "title": "Kafka details", "tooltip": "Open the shared Kafka and outbox dashboard", "type": "link", "url": "/d/kafka-messaging-overview/kafka-messaging-overview" }
  ],
  "liveNow": true,
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "panels": [], "title": "Service Vitals", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Percentage of selected Prometheus ledger targets currently reporting up.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 100 }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "100 * sum(up{job=\"ledger-service\",instance=~\"$instance\"}) / clamp_min(count(up{job=\"ledger-service\",instance=~\"$instance\"}), 1)", "legendFormat": "instances up", "range": true, "refId": "A" }],
      "title": "Instances Up", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Instrumented ledger business-boundary request rate for the selected ingress.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 }, "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(zexchange_ledger_requests_total{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\"}[$__rate_interval]))", "legendFormat": "requests", "range": true, "refId": "A" }],
      "title": "Business Request Rate", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "All ledger business errors, including request_in_processing. Use the error-code panel below to distinguish expected contention from actionable failures.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 2, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.001 }] }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 }, "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(zexchange_ledger_requests_total{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\",outcome=\"error\"}[$__rate_interval])) or vector(0)", "legendFormat": "business errors", "range": true, "refId": "A" }],
      "title": "Business Errors", "type": "stat"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 101, "panels": [], "title": "Ledger Business", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 }, "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (operation, ingress, outcome) (rate(zexchange_ledger_requests_total{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\"}[$__rate_interval]))", "legendFormat": "{{operation}} / {{ingress}} / {{outcome}}", "range": true, "refId": "A" }],
      "title": "Business Request Outcomes", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Overall versus successful-result p95 and p99. The success series prevents fast failures from making completed work look faster, while p99 exposes tail latency hidden by p95.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 }, "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.95, sum by (le, operation, ingress) (rate(zexchange_ledger_processing_duration_seconds_bucket{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\"}[$__rate_interval])))", "legendFormat": "{{operation}} / {{ingress}} overall p95", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.95, sum by (le, operation, ingress) (rate(zexchange_ledger_processing_duration_seconds_bucket{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "{{operation}} / {{ingress}} success p95", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.99, sum by (le, operation, ingress) (rate(zexchange_ledger_processing_duration_seconds_bucket{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\"}[$__rate_interval])))", "legendFormat": "{{operation}} / {{ingress}} overall p99", "range": true, "refId": "C" },
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.99, sum by (le, operation, ingress) (rate(zexchange_ledger_processing_duration_seconds_bucket{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\",outcome=\"success\"}[$__rate_interval])))", "legendFormat": "{{operation}} / {{ingress}} success p99", "range": true, "refId": "D" }
      ],
      "title": "Business Processing p95 / p99", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "New commits and successful idempotent replays. Replay source distinguishes Redis fast-path hits from the database backstop.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 }, "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(zexchange_ledger_transactions_created_total{application=\"ledger-service\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "created", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum by (source) (rate(zexchange_ledger_transactions_idempotent_total{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\"}[$__rate_interval]))", "legendFormat": "idempotent / {{source}}", "range": true, "refId": "B" }
      ],
      "title": "Created and Idempotent Transactions", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Business failures by bounded error code. request_in_processing is visible but should be evaluated separately from terminal failures.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 }, "id": 9,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (operation, error_code) (rate(zexchange_ledger_requests_total{application=\"ledger-service\",instance=~\"$instance\",ingress=~\"$ingress\",outcome=\"error\"}[$__rate_interval]))", "legendFormat": "{{operation}} / {{error_code}}", "range": true, "refId": "A" }],
      "title": "Business Errors by Code", "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }, "id": 102, "panels": [], "title": "Issue Locator", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Transport-level failures only. Open gRPC details for per-method status and latency breakdowns.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 2, "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 1 }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 21 }, "id": 11,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "100 * sum(rate(zexchange_grpc_server_duration_seconds_count{application=\"ledger-service\",instance=~\"$instance\",grpc_status!=\"OK\"}[$__rate_interval])) / clamp_min(sum(rate(zexchange_grpc_server_duration_seconds_count{application=\"ledger-service\",instance=~\"$instance\"}[$__rate_interval])), 0.000001)", "legendFormat": "non-OK", "range": true, "refId": "A" }],
      "title": "gRPC Non-OK Rate", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "MyBatis execution failures. Open Data Access and Resilience for statement and error-type detail.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 0.001 }] }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 21 }, "id": 12,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(zexchange_db_operation_errors_total{application=\"ledger-service\",instance=~\"$instance\"}[$__rate_interval])) or vector(0)", "legendFormat": "DB errors", "range": true, "refId": "A" }],
      "title": "DB Operation Errors", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Low-level Redis calls that completed with outcome=error.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 0.001 }] }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 21 }, "id": 14,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(zexchange_redis_operation_duration_seconds_count{application=\"ledger-service\",instance=~\"$instance\",outcome=\"error\"}[$__rate_interval])) or vector(0)", "legendFormat": "Redis errors", "range": true, "refId": "A" }],
      "title": "Redis Operation Errors", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Broker-acknowledged publisher failures divided by all completed publish attempts. Open Kafka details for topic, source, outbox-delay, and listener views.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 2, "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 1 }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 21 }, "id": 17,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "100 * sum(rate(zexchange_kafka_publisher_requests_total{application=\"ledger-service\",instance=~\"$instance\",outcome=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(zexchange_kafka_publisher_requests_total{application=\"ledger-service\",instance=~\"$instance\"}[$__rate_interval])), 0.000001)", "legendFormat": "publisher errors", "range": true, "refId": "A" }],
      "title": "Kafka Publisher Error Rate", "type": "stat"
    }
  ],
