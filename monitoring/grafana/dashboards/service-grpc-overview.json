{
  "annotations": { "list": [] },
  "description": "Reusable gRPC traffic, latency, saturation, and transport-error dashboard for Z-Exchange services.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "panels": [], "title": "Summary", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(zexchange_grpc_server_duration_seconds_count{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "requests", "range": true, "refId": "A" }],
      "title": "Request Rate", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Transport-level non-OK responses divided by all completed gRPC calls. Business errors returned in an OK protobuf response are not counted here.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 2, "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 1 }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 }, "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "100 * sum(rate(zexchange_grpc_server_duration_seconds_count{application=~\"$application\",instance=~\"$instance\",grpc_status!=\"OK\"}[$__rate_interval])) / clamp_min(sum(rate(zexchange_grpc_server_duration_seconds_count{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval])), 0.000001)", "legendFormat": "non-OK", "range": true, "refId": "A" }],
      "title": "Non-OK Rate", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Overall p95 includes all statuses; OK p95 includes transport-successful calls only.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 250 }, { "color": "red", "value": 1000 }] }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 }, "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(zexchange_grpc_server_duration_seconds_bucket{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "overall p95", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(zexchange_grpc_server_duration_seconds_bucket{application=~\"$application\",instance=~\"$instance\",grpc_status=\"OK\"}[$__rate_interval])))", "legendFormat": "OK p95", "range": true, "refId": "B" }
      ],
      "title": "p95 Overall / OK", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 }, "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(zexchange_grpc_server_active{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "active", "range": true, "refId": "A" }],
      "title": "Active Calls", "type": "stat"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 101, "panels": [], "title": "Traffic and Latency", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }, "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (application, service, method, grpc_status) (rate(zexchange_grpc_server_duration_seconds_count{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{application}} / {{service}} / {{method}} / {{grpc_status}}", "range": true, "refId": "A" }],
      "title": "Rate by Method and Status", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Successful transport calls only; protobuf business failures may still be included when their gRPC status is OK.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }, "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.50, sum by (le, application, service, method) (rate(zexchange_grpc_server_duration_seconds_bucket{application=~\"$application\",instance=~\"$instance\",grpc_status=\"OK\"}[$__rate_interval])))", "legendFormat": "{{application}} / {{service}} / {{method}} p50", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.95, sum by (le, application, service, method) (rate(zexchange_grpc_server_duration_seconds_bucket{application=~\"$application\",instance=~\"$instance\",grpc_status=\"OK\"}[$__rate_interval])))", "legendFormat": "{{application}} / {{service}} / {{method}} p95", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "1000 * histogram_quantile(0.99, sum by (le, application, service, method) (rate(zexchange_grpc_server_duration_seconds_bucket{application=~\"$application\",instance=~\"$instance\",grpc_status=\"OK\"}[$__rate_interval])))", "legendFormat": "{{application}} / {{service}} / {{method}} p99", "range": true, "refId": "C" }
      ],
      "title": "Latency by Method (OK)", "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 102, "panels": [], "title": "Transport Errors", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 }, "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (application, service, method, grpc_status) (rate(zexchange_grpc_server_duration_seconds_count{application=~\"$application\",instance=~\"$instance\",grpc_status!=\"OK\"}[$__rate_interval]))", "legendFormat": "{{application}} / {{service}} / {{method}} / {{grpc_status}}", "range": true, "refId": "A" }],
      "title": "Non-OK Rate by Method and Status", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Per-method non-OK percentage; useful when a low-volume failing method is hidden by healthy aggregate traffic.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 }, "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "100 * sum by (application, service, method) (rate(zexchange_grpc_server_duration_seconds_count{application=~\"$application\",instance=~\"$instance\",grpc_status!=\"OK\"}[$__rate_interval])) / clamp_min(sum by (application, service, method) (rate(zexchange_grpc_server_duration_seconds_count{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval])), 0.000001)", "legendFormat": "{{application}} / {{service}} / {{method}}", "range": true, "refId": "A" }],
      "title": "Non-OK Percentage by Method", "type": "timeseries"
    }
