        { "editorMode": "code", "expr": "sum(rate(k6_ledger_requests_completed_total{scenario=~\"$scenario\"}[$__rate_interval])) or sum(rate(zexchange_grpc_server_duration_seconds_count{instance=~\"$instance\",method=\"postTransaction\"}[$__rate_interval]))", "legendFormat": "completed", "range": true, "refId": "B" },
