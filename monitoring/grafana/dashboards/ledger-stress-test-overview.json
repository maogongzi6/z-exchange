        { "editorMode": "code", "expr": "1000 * k6_ledger_write_request_duration_p99{testid=~\"$testid\",test_profile=~\"$test_profile\",operation=\"postTransaction\",request_kind=\"\"}", "legendFormat": "overall p99", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "1000 * k6_ledger_write_success_duration_p95{testid=~\"$testid\",test_profile=~\"$test_profile\",operation=\"postTransaction\"}", "legendFormat": "successful p95", "range": true, "refId": "C" },
        { "editorMode": "code", "expr": "1000 * k6_ledger_write_success_duration_p99{testid=~\"$testid\",test_profile=~\"$test_profile\",operation=\"postTransaction\"}", "legendFormat": "successful p99", "range": true, "refId": "D" }
