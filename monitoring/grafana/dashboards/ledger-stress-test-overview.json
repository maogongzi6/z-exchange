  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Actual RPC attempts generated by k6, completed RPCs, and successful business responses. Offered TPS includes original and duplicate requests and is therefore higher than the configured logical transaction arrival rate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "RPC/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "decimals": 1,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(k6_ledger_write_offered_total{testid=~\"$testid\",test_profile=~\"$test_profile\"}[$__rate_interval]))", "legendFormat": "offered RPC TPS", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(k6_ledger_write_completed_total{testid=~\"$testid\",test_profile=~\"$test_profile\"}[$__rate_interval]))", "legendFormat": "completed RPC TPS", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate(k6_ledger_write_successful_total{testid=~\"$testid\",test_profile=~\"$test_profile\"}[$__rate_interval]))", "legendFormat": "successful RPC TPS", "range": true, "refId": "C" }
      ],
      "title": "Ledger Write RPC Throughput",
      "type": "timeseries"
    },
    {
