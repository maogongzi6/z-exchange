      "targets": [{ "editorMode": "code", "expr": "100 * sum(rate(zexchange_ledger_requests_total{instance=~\"$instance\",operation=\"post_transaction\",outcome=\"error\",error_code!=\"request_in_processing\"}[$__rate_interval])) / clamp_min(sum(rate(zexchange_ledger_requests_total{instance=~\"$instance\",operation=\"post_transaction\"}[$__rate_interval])), 0.000001)", "legendFormat": "unexpected errors", "range": true, "refId": "A" }],
