{
  "annotations": { "list": [] },
  "description": "Reusable JVM and process-runtime dashboard for Z-Exchange services. Database connection-pool metrics live in Data Access and Resilience.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "panels": [], "title": "Summary", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Shortest uptime among selected instances, making a recent restart visible even when other instances have been running longer.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "min(process_uptime_seconds{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "shortest uptime", "range": true, "refId": "A" }],
      "title": "Shortest Instance Uptime", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 }, "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "100 * avg(process_cpu_usage{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "process CPU", "range": true, "refId": "A" }],
      "title": "Average Process CPU", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Selected instances' heap usage divided by their reported positive heap maximum.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 }, "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "100 * sum(jvm_memory_used_bytes{application=~\"$application\",instance=~\"$instance\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{application=~\"$application\",instance=~\"$instance\",area=\"heap\"} > 0), 1)", "legendFormat": "heap used", "range": true, "refId": "A" }],
      "title": "Heap Usage", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Largest GC pause observed over the selected rate interval.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 }, "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "1000 * max(max_over_time(jvm_gc_pause_seconds_max{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "max pause", "range": true, "refId": "A" }],
      "title": "Max GC Pause", "type": "stat"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 101, "panels": [], "title": "Memory and Garbage Collection", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Heap used and maximum by instance. A missing or negative maximum is excluded from the max series.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }, "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (application, instance) (jvm_memory_used_bytes{application=~\"$application\",instance=~\"$instance\",area=\"heap\"})", "legendFormat": "{{application}} / {{instance}} used", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum by (application, instance) (jvm_memory_max_bytes{application=~\"$application\",instance=~\"$instance\",area=\"heap\"} > 0)", "legendFormat": "{{application}} / {{instance}} max", "range": true, "refId": "B" }
      ],
      "title": "Heap Used / Max", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "description": "Average pause duration and rolling maximum by instance for correlation with request latency spikes.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }, "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "1000 * sum by (application, instance) (rate(jvm_gc_pause_seconds_sum{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum by (application, instance) (rate(jvm_gc_pause_seconds_count{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval])), 0.000001)", "legendFormat": "{{application}} / {{instance}} average", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "1000 * max by (application, instance) (max_over_time(jvm_gc_pause_seconds_max{application=~\"$application\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{application}} / {{instance}} max", "range": true, "refId": "B" }
      ],
      "title": "GC Pause", "type": "timeseries"
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 102, "panels": [], "title": "CPU and Threads", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 }, "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "100 * avg by (application, instance) (process_cpu_usage{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "{{application}} / {{instance}} process", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "100 * avg by (application, instance) (system_cpu_usage{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "{{application}} / {{instance}} system", "range": true, "refId": "B" }
      ],
      "title": "CPU Usage", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 }, "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (application, instance) (jvm_threads_live_threads{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "{{application}} / {{instance}} live", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum by (application, instance) (jvm_threads_daemon_threads{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "{{application}} / {{instance}} daemon", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum by (application, instance) (jvm_threads_peak_threads{application=~\"$application\",instance=~\"$instance\"})", "legendFormat": "{{application}} / {{instance}} peak", "range": true, "refId": "C" }
      ],
      "title": "JVM Threads", "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["zexchange", "service", "jvm", "runtime", "shared"],
  "templating": {
    "list": [
      { "allValue": ".*", "current": { "selected": true, "text": "ledger-service", "value": "ledger-service" }, "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" }, "definition": "label_values(up{job=~\".*-service\"}, job)", "hide": 0, "includeAll": true, "label": "application", "multi": true, "name": "application", "options": [], "query": "label_values(up{job=~\".*-service\"}, job)", "refresh": 1, "regex": "", "skipUrlSync": false, "sort": 1, "type": "query" },
      { "allValue": ".*", "current": { "selected": true, "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "zexchange-prometheus" }, "definition": "label_values(up{job=~\"$application\"}, instance)", "hide": 0, "includeAll": true, "label": "instance", "multi": true, "name": "instance", "options": [], "query": "label_values(up{job=~\"$application\"}, instance)", "refresh": 1, "regex": "", "skipUrlSync": false, "sort": 1, "type": "query" }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Service Runtime Overview",
  "uid": "service-runtime-overview",
  "version": 1,
  "weekStart": ""
}
